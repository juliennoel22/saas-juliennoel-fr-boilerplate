# ==============================================================================
# Application URL & Runtime
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Supabase (Database, Auth, Storage)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================================
# Stripe (Hosted Checkout + Customer Portal + Webhooks)
# ==============================================================================
STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<STRIPE_WEBHOOK_SECRET>
# Optional pre-created Price IDs (falls back to inline price_data from src/config/site.ts)
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=

# ==============================================================================
# AI Layer (100% Provider-Agnostic via Vercel AI SDK)
# Supported AI_PROVIDER: openrouter | google | openai | mistral | anthropic
# ==============================================================================
AI_PROVIDER=openrouter
AI_MODEL=google/gemini-2.5-flash
AI_API_KEY=
# Dedicated provider keys (auto-detected if AI_API_KEY is empty)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
# Optional automatic fallback on 5xx / rate-limit / timeout
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=

# ==============================================================================
# Optional Web Search (Tavily)
# ==============================================================================
TAVILY_API_KEY=

# ==============================================================================
# PostHog Analytics (Zero-Flicker SSR Bootstrap + /ingest Proxy)
# ==============================================================================
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional comma-separated internal email addresses/substrings excluded from PostHog analytics
POSTHOG_EXCLUDED_EMAILS=

# ==============================================================================
# Transactional Email (Resend - logs to console in dev when empty)
# ==============================================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# ==============================================================================
# Access & MCP Endpoint (/api/mcp)
# ==============================================================================
# Comma-separated VIP bypass codes for internal testing (never creates live Stripe charges)
VIP_BYPASS_CODES=
# Optional bearer token protecting /api/mcp when features.mcpEnabled = true
MCP_API_KEY=
